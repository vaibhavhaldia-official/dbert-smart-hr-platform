# =====================================================================
# GayatriBot — environment configuration
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Real environment variables take precedence over values in .env, so CI
# and production can run with no file present.
#
# During development use a DEVELOPER-OWNED TEST Gmail account and a
# NON-PRODUCTION Google Sheet. Production credentials are configured by
# the project owner directly in the production environment at handover.
# =====================================================================

# ---------------------------------------------------------------------
# SMTP SENDER POOL  (required to send mail)
# Gmail requires an App Password (Google Account > Security > App
# Passwords, 2FA must be enabled). Senders are numbered from 1.
# ---------------------------------------------------------------------
GAYATRI_SENDER_1_EMAIL=
GAYATRI_SENDER_1_PASSWORD=
GAYATRI_SENDER_1_NAME=

# Add further senders as needed (up to 10).
# GAYATRI_SENDER_2_EMAIL=
# GAYATRI_SENDER_2_PASSWORD=
# GAYATRI_SENDER_2_NAME=

# SMTP transport defaults (optional)
GAYATRI_SMTP_HOST=smtp.gmail.com
GAYATRI_SMTP_PORT=587
GAYATRI_SMTP_USE_TLS=true
GAYATRI_SMTP_DISPLAY_NAME=
GAYATRI_REPLY_TO=

# ---------------------------------------------------------------------
# GOOGLE SHEETS  (required by bot.py and dashboard sheet-sync)
# Use a NON-PRODUCTION spreadsheet during development. The service
# account email inside the JSON key must be granted Editor access.
# ---------------------------------------------------------------------
GAYATRI_SHEET_ID=
GAYATRI_SHEET_GID=0
GAYATRI_SHEET_NAME=
GAYATRI_SERVICE_ACCOUNT=service_account.json

# ---------------------------------------------------------------------
# DASHBOARD
# Bind address defaults to 127.0.0.1 (loopback only). The dashboard has
# NO AUTHENTICATION: changing this exposes applicant data and the ability
# to trigger email campaigns to anyone who can reach the host. Do not
# change it without authentication, HTTPS and network access controls.
# ---------------------------------------------------------------------
GAYATRI_FLASK_HOST=127.0.0.1
# Port defaults to 5000, or 5050 on macOS (AirPlay Receiver occupies 5000).
GAYATRI_FLASK_PORT=
GAYATRI_FLASK_DEBUG=false
# Flask session signing key. If unset, a random key is generated per
# process and sessions do not survive a restart.
GAYATRI_SECRET_KEY=

# ---------------------------------------------------------------------
# DATABASE  (path is resolved relative to the project directory)
# Must be on a local disk — WAL mode is unsupported on many network shares.
# ---------------------------------------------------------------------
GAYATRI_DB=gayatri.db
GAYATRI_DB_TIMEOUT=30
GAYATRI_DB_BUSY_TIMEOUT_MS=30000

# ---------------------------------------------------------------------
# PDF ENGINE
# Auto-detected: LibreOffice if found, otherwise the reportlab fallback.
# Force with: libreoffice | reportlab
# ---------------------------------------------------------------------
GAYATRI_PDF_ENGINE=
GAYATRI_PDF_TIMEOUT=120
# Explicit path to the soffice binary if installed non-standardly.
GAYATRI_SOFFICE_PATH=

# ---------------------------------------------------------------------
# POLLING, RATE LIMITS, RETRY
# ---------------------------------------------------------------------
GAYATRI_POLL_INTERVAL=300
GAYATRI_SMTP_MIN_DELAY=50
GAYATRI_SMTP_MAX_DELAY=70
GAYATRI_RATE_LIMIT_HOUR=25
GAYATRI_RATE_LIMIT_DAY=360
GAYATRI_MAX_RETRIES=3
GAYATRI_RETRY_BACKOFF=30

# ---------------------------------------------------------------------
# RUNTIME PATHS AND RECIPIENTS
# ---------------------------------------------------------------------
GAYATRI_LOG_FILE=bot.log
GAYATRI_OUTPUT_DIR=generated_offers
GAYATRI_UPLOAD_DIR=uploads
GAYATRI_ENROLLMENT_CSV=enrollment.csv
GAYATRI_SELECTED_CSV=selected2.csv
GAYATRI_OFFER_TEMPLATE=sampleoffer.docx

# Recipient for dashboard "send test email". Use a developer-owned address.
GAYATRI_TEST_RECIPIENT=
GAYATRI_SUMMARY_RECIPIENT=
